{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user with role and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "username": { "type": "string", "description": "Login username" },
        "password": { "type": "string", "description": "Login password" },
        "name": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "enum": ["ADMIN", "NORMAL"], "description": "User role" }
      },
      "required": ["id", "username", "password", "name", "role"]
    },
    "Calculation": {
      "title": "Calculation",
      "description": "Saved concrete dosage calculation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "inputs": { "type": "object" },
        "results": { "type": "object" }
      },
      "required": ["id", "userId", "timestamp", "inputs", "results"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/calculations/{calcId}": {
      "schema": "Calculation",
      "description": "Saved calculations"
    }
  }
}
