// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: userId
// Fields:
//   - id: string (required) - Unique identifier
//   - username: string (required) - Login username
//   - password: string (required) - Login password
//   - name: string (required) - Display name
//   - role: string (required, enum: ["ADMIN", "NORMAL"]) - User role
//
// Collection: calculations
// Document ID: calcId
// Fields:
//   - id: string (required)
//   - userId: string (required)
//   - timestamp: string (required, date-time)
//   - inputs: map (required)
//   - results: map (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          (request.auth.token.email == "benhur.psilva@gmail.com" && request.auth.token.email_verified == true));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'name', 'role']) &&
             data.id is string &&
             data.username is string &&
             data.name is string &&
             data.role in ['ADMIN', 'NORMAL'];
    }

    function isValidCalculation(data) {
      return data.keys().hasOnly(['id', 'userId', 'timestamp', 'inputs', 'results']) &&
             data.id is string &&
             data.userId is string &&
             data.timestamp is string &&
             data.inputs is map &&
             data.results is map;
    }

    match /test/connection {
      allow read: if true;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && isValidUser(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /calculations/{calcId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCalculation(request.resource.data);
      allow update: if isAuthenticated() && isValidCalculation(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
